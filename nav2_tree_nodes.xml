<?xml version="1.0"?>
<!--
  For instructions on using Groot and description of the following BehaviorTree nodes,
  please refer to the groot_instructions.md and README.md respectively located in the
  nav2_behavior_tree package.
-->
<root BTCPP_format="4">
  <TreeNodesModel>
    <Action ID="NavigateToPoseGoal">
      <input_port name="x">Goal x [m]</input_port>
      <input_port name="y">Goal y [m]</input_port>
      <input_port name="yaw">Goal yaw [rad]</input_port>
      <input_port name="frame_id" default="map">Goal frame</input_port>
      <input_port name="server_name">Action server (default: navigate_to_pose)</input_port>
      <input_port name="server_timeout">Goal acknowledgement/cancellation timeout [ms]</input_port>
    </Action>
    <!-- ############################### ACTION NODES ################################# -->

    <Action ID="SetDumpAngle">
      <input_port name="target_angle">Target angle [rad]</input_port>
      <input_port name="server_name">Action server name (default: set_dump_angle)</input_port>
      <input_port name="server_timeout">Goal acknowledgement/cancellation timeout [ms]</input_port>
      <output_port name="current_error">Server feedback error [rad]</output_port>
    </Action>

    <Action ID="SetSwingAngle">
      <input_port name="target_angle">Target angle [rad]</input_port>
      <input_port name="server_name">Action server name (default: set_swing_angle)</input_port>
      <input_port name="server_timeout">Goal acknowledgement/cancellation timeout [ms]</input_port>
      <output_port name="current_error">Server feedback error [rad]</output_port>
    </Action>

    <Action ID="SetPathGoalOrientation">
      <input_port name="input_path">Smoothed path in the goal frame</input_port>
      <input_port name="goal">Requested final goal pose</input_port>
      <input_port name="position_tolerance" default="0.1">Maximum XY endpoint distance [m]; mismatch fails</input_port>
      <output_port name="output_path">Terminal duplicates updated with normalized goal orientation</output_port>
    </Action>

    <Action ID="AlignPathOrientations">
      <input_port name="input_path">Forward-only path</input_port>
      <output_port name="output_path">Path with forward orientations; final pose preserved</output_port>
    </Action>

    <Action ID="WaitCustom">
      <input_port name="wait_duration">Wait time</input_port>
      <input_port name="server_name">Server name</input_port>
      <input_port name="server_timeout">Server timeout</input_port>
      <output_port name="error_code_id">Wait error code</output_port>
      <output_port name="error_msg">Wait error message</output_port>
    </Action>

    <Action ID="EnableRouteSwitcher">
      <input_port name="default_value">Default value</input_port>
      <input_port name="topic_name">Topic name</input_port>
      <output_port name="enable_route">Enable route server</output_port>
    </Action>

    <Action ID="CheckSafety">
    </Action>

    <Action ID="GetArea">
      <input_port name="pose">Robot pose</input_port>
      <output_port name="area_id">Area ID</output_port>
      <output_port name="entry_node_id">Entry node ID</output_port>
      <output_port name="exit_node_id">Exit node ID</output_port>
      <output_port name="entry_node_pose">Entry node pose</output_port>
      <output_port name="exit_node_pose">Exit node pose</output_port>
    </Action>

  </TreeNodesModel>
</root>
